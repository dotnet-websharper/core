<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Name>wsfscservice</Name>
    <AssemblyName>wsfscservice</AssemblyName>
    <FSharpTool>True</FSharpTool>
    <WarnOn>3390;$(WarnOn)</WarnOn>
    <Signed>False</Signed>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- the platforms of the Booster tools (boosterRids in build.fsx) -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <RollForward>LatestMajor</RollForward>
	  <ApplicationIcon>../../../tools/WebSharper.ico</ApplicationIcon>
    <!-- Same GC settings as fsc: compilation allocates heavily from several threads -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <!-- ReadyToRun for every platform publish, the portable publish (no RuntimeIdentifier) stays IL only -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Include="BoosterPipe.fs" />
    <Compile Include="Stats.fs" />
    <Compile Include="AgentTools.fs" />
    <Compile Include="Mcp.fs" />
    <Compile Include="Program.fs" />
    <Content Include="App.config" />
    <None Include="paket.references" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WebSharper.Compiler.FSharp\WebSharper.Compiler.FSharp.fsproj" />
  </ItemGroup>
  <Import Project="..\..\..\msbuild\FSharp.targets" />
  <Target Name="CopyToOutput" AfterTargets="Build;Publish" Condition="$(TargetFramework.StartsWith('net4'))">
    <Copy SourceFiles="..\..\..\packages\includes\NETStandard.Library\build\netstandard2.0\ref\netstandard.dll" DestinationFiles="$(OutputPath)\netstandard.dll" />
  </Target>
  <Import Project="..\..\..\.paket\Paket.Restore.targets" />
</Project>
