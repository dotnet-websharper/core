<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Output.fsi" />
    <Compile Include="Output.fs" />
    <Compile Include="HtmlCommand.fs" />
    <None Include="paket.references" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\compiler\WebSharper.Compiler\WebSharper.Compiler.fsproj" />
    <ProjectReference Include="..\..\compiler\WebSharper.Core.JavaScript\WebSharper.Core.JavaScript.fsproj" />
    <ProjectReference Include="..\..\compiler\WebSharper.Core\WebSharper.Core.fsproj" />
    <ProjectReference Include="..\..\stdlib\WebSharper.StdLib\WebSharper.StdLib.fsproj" />
    <ProjectReference Include="..\WebSharper.Sitelets\WebSharper.Sitelets.fsproj" />
    <ProjectReference Include="..\WebSharper.Web\WebSharper.Web.fsproj" />
  </ItemGroup>
  <!-- the compilers load it for offline sitelets (html projects): copied next to the built compilers, and into
       every published compiler folder (portable and each Booster platform, published before WebSharper.sln builds) -->
  <Target Name="_CopyToDeploy" AfterTargets="Build">
    <ItemGroup>
      <_WebSharperCompilerFolder Include="$(OutputPath)\..\FSharp\net11.0" />
      <_WebSharperCompilerFolder Include="$(OutputPath)\..\CSharp\net11.0" />
      <_WebSharperPublishedCompiler Include="$(OutputPath)\..\FSharp\net11.0\deploy\wsfsc.dll;$(OutputPath)\..\FSharp\net11.0\*\deploy\wsfsc.dll" />
      <_WebSharperPublishedCompiler Include="$(OutputPath)\..\CSharp\net11.0\deploy\wscsc.dll;$(OutputPath)\..\CSharp\net11.0\*\deploy\wscsc.dll" />
      <_WebSharperCompilerFolder Include="@(_WebSharperPublishedCompiler->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <Copy SourceFiles="$(OutputPath)\WebSharper.Sitelets.Offline.dll" DestinationFolder="%(_WebSharperCompilerFolder.Identity)" />
  </Target>
  <Import Project="..\..\..\msbuild\FSharp.targets" />
  <Import Project="..\..\..\.paket\Paket.Restore.targets" />
</Project>
