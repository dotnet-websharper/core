<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- imported before the project file: Microsoft.Common.CurrentVersion.targets defaults
       ProduceReferenceAssembly to false before the .targets files of packages are imported -->
  <PropertyGroup>
    <!-- reference assemblies: dependent projects recompile when the WebSharper stamps they list in .websharper.deps change -->
    <ProduceReferenceAssembly Condition=" '$(ProduceReferenceAssembly)' == '' ">True</ProduceReferenceAssembly>
  </PropertyGroup>
</Project>
