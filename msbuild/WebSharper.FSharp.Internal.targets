<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)FSharp.targets" />
  <PropertyGroup>
    <WebSharperRunCompiler Condition=" '$(DesignTimeBuild)' == 'true' " >False</WebSharperRunCompiler>
    <WebSharperRunCompiler Condition=" '$(WebSharperRunCompiler)' == '' ">True</WebSharperRunCompiler>
    <WebSharperTaskAssembly Condition=" '$(WebSharperTaskAssembly)' == ''">$(Root)/build/$(Configuration)/FSharp/netstandard2.0/WebSharper.MSBuild.FSharp.dll</WebSharperTaskAssembly>
    <!-- reference assemblies: dependent projects recompile when the WebSharper stamps they list in .websharper.deps change -->
    <ProduceReferenceAssembly Condition=" '$(ProduceReferenceAssembly)' == '' ">True</ProduceReferenceAssembly>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(WebSharperRunCompiler)' == 'True' ">
    <WebSharperToolPath Condition=" '$(WebSharperToolPath)' == '' AND '$(OS)' == 'Windows_NT' ">$(Root)/build/$(Configuration)/FSharp/net11.0/wsfsc.exe</WebSharperToolPath>
    <WebSharperToolPath Condition=" '$(WebSharperToolPath)' == '' AND '$(OS)' != 'Windows_NT' ">$(Root)/build/$(Configuration)/FSharp/net11.0/wsfsc.sh</WebSharperToolPath>
    <WebSharperSourceMap Condition=" '$(WebSharperSourceMap)' == '' ">True</WebSharperSourceMap>
    <WebSharperTypeScriptOutput Condition=" '$(WebSharperTypeScriptOutput)' == '' ">True</WebSharperTypeScriptOutput>
    <WebSharperConfigFile Condition=" '$(WebSharperConfigFile)' == '' AND Exists('$(MSBuildProjectDirectory)/wsconfig.$(MSBuildProjectName).json') ">$(MSBuildProjectDirectory)/wsconfig.$(MSBuildProjectName).json</WebSharperConfigFile>
    <WebSharperConfigFile Condition=" '$(WebSharperConfigFile)' == '' AND Exists('$(MSBuildProjectDirectory)/wsconfig.json') ">$(MSBuildProjectDirectory)/wsconfig.json</WebSharperConfigFile>
    <SkipCompilerExecution>True</SkipCompilerExecution>
    <ProvideCommandLineArgs>True</ProvideCommandLineArgs>
    <NoWarn>$(NoWarn);3366;3370</NoWarn>
    <CompileTypeScriptDependsOn>$(CompileTypeScriptDependsOn);WebSharperCompile;</CompileTypeScriptDependsOn>
  </PropertyGroup>
  <Target Name="RecompileOnConfigChanges" BeforeTargets="BeforeBuild" Condition=" '$(WebSharperRunCompiler)' == 'True' AND '$(WebSharperConfigFile)' != '' AND Exists('$(WebSharperConfigFile)') ">
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="$(WebSharperConfigFile)" />
    </ItemGroup>
  </Target>
  <!-- Recompile when files written by the last WebSharper compilation are missing, for example after deleting an output folder -->
  <Target Name="WebSharperCheckOutputFiles" BeforeTargets="BeforeBuild" Condition=" '$(WebSharperRunCompiler)' == 'True' ">
    <PropertyGroup>
      <WebSharperOutputFilesList>@(IntermediateAssembly->'%(RootDir)%(Directory)%(Filename).websharper.files')</WebSharperOutputFilesList>
    </PropertyGroup>
    <ReadLinesFromFile File="$(WebSharperOutputFilesList)" Condition="Exists('$(WebSharperOutputFilesList)')">
      <Output TaskParameter="Lines" ItemName="_WebSharperOutputFile" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_WebSharperMissingOutputFile Include="@(_WebSharperOutputFile)" Condition="!Exists('%(_WebSharperOutputFile.Identity)')" />
      <FileWrites Include="$(WebSharperOutputFilesList)" />
    </ItemGroup>
    <Message Importance="high" Text="$(MSBuildProjectName): recompiling, @(_WebSharperMissingOutputFile->Count()) WebSharper output file(s) are missing" Condition=" '@(_WebSharperMissingOutputFile)' != '' " />
    <Message Importance="normal" Text="Missing: %(_WebSharperMissingOutputFile.Identity)" Condition=" '@(_WebSharperMissingOutputFile)' != '' " />
    <Touch Files="$(WebSharperOutputFilesList)" Condition=" '@(_WebSharperMissingOutputFile)' != '' " />
    <ItemGroup Condition=" '@(_WebSharperMissingOutputFile)' != '' ">
      <CustomAdditionalCompileInputs Include="$(WebSharperOutputFilesList)" />
    </ItemGroup>
  </Target>
  <UsingTask AssemblyFile="$(WebSharperTaskAssembly)" TaskName="WebSharper.MSBuild.FSharp.ReorderCompileItemsTask" Condition=" '$(DesignTimeBuild)' == 'true' " />
  <Target Name="ReorderWebSharperGeneratedFiles" Condition=" '$(DesignTimeBuild)' == 'true' " BeforeTargets="CoreCompile">
    <ItemGroup>
      <ExistingCompile Include="@(Compile)" />
      <Compile Remove="@(Compile)" />
    </ItemGroup>
    <ReorderCompileItemsTask
      ExistingCompileItems="@(ExistingCompile)">
      <Output TaskParameter="ReorderedCompileItems" ItemName="Compile" />
    </ReorderCompileItemsTask>
  </Target>
  <UsingTask AssemblyFile="$(WebSharperTaskAssembly)" TaskName="WebSharper.MSBuild.FSharp.WebSharperTask" Condition=" '$(WebSharperRunCompiler)' == 'True' " />
  <Target Name="WebSharperCompile" Condition=" '$(WebSharperRunCompiler)' == 'True' AND '@(FscCommandLineArgs)' != '' " AfterTargets="CoreCompile" BeforeTargets="PreComputeCompileTypeScript;PreComputeCompileTypeScriptWithTSConfig">
    <Exec Command="chmod u+x '$(WebSharperToolPath)'" Condition="'$(OS)' != 'Windows_NT'" />
    <WebSharperTask
      StandardOutputImportance="$(WebSharperLogImportance)"
      FscCommandLineArgs="@(FscCommandLineArgs)"
      Configuration="$(Configuration)"
      MSBuildProjectFullPath="$(MSBuildProjectFullPath)"
      WebProjectOutputDir="$(WebProjectOutputDir)"
      WebSharperConfigFile="$(WebSharperConfigFile)"
      WebSharperBundleOutputDir="$(WebSharperBundleOutputDir)"
      WebSharperHtmlDirectory="$(WebSharperHtmlDirectory)"
      WebSharperProject="$(WebSharperProject)" 
      WebSharperSourceMap="$(WebSharperSourceMap)"          
      WebSharperTypeScriptDeclaration="$(WebSharperTypeScriptDeclaration)"          
      WebSharperTypeScriptOutput="$(WebSharperTypeScriptOutput)"          
      WebSharperErrorsAsWarnings="$(WebSharperErrorsAsWarnings)"
      WebSharperDeadCodeElimination="$(WebSharperDeadCodeElimination)"
      WebSharperDownloadResources="$(WebSharperDownloadResources)"
      WebSharperAnalyzeClosures="$(WebSharperAnalyzeClosures)"
      WebSharperJsOutput="$(WebSharperJsOutput)"
      WebSharperMinJsOutput="$(WebSharperMinJsOutput)"
      WebSharperTimingLog="$(WebSharperTimingLog)"
      WebSharperToolPath="$(WebSharperToolPath)"
      WebSharperStandalone="$(WebSharperStandalone)"
      WebSharperTransparentCompiler="$(WebSharperTransparentCompiler)"
      WebSharperParallelCompilation="$(WebSharperParallelCompilation)"
      RefAssembly="@(IntermediateRefAssembly)"
    />
  </Target>
  <!-- WebSharper sidecar file: <AssemblyName>.websharper, written by the WebSharper compiler next to the intermediate assembly -->
  <PropertyGroup>
    <!-- copied with references, like .pdb and .xml files -->
    <AllowedReferenceRelatedFileExtensions>$(AllowedReferenceRelatedFileExtensions);.websharper</AllowedReferenceRelatedFileExtensions>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);WebSharperPackSidecar</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <!-- marks the assembly as having a sidecar, so a copy without it is reported -->
  <ItemGroup Condition=" '$(WebSharperSidecarMarker)' != 'False' ">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WebSharper.Sidecar</_Parameter1>
      <_Parameter2>1</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="WebSharperCopySidecar" AfterTargets="CopyFilesToOutputDirectory" Condition=" '$(WebSharperRunCompiler)' == 'True' ">
    <PropertyGroup>
      <_WebSharperSidecar>@(IntermediateAssembly->'%(RootDir)%(Directory)%(Filename).websharper')</_WebSharperSidecar>
      <_WebSharperStamp>@(IntermediateAssembly->'%(RootDir)%(Directory)%(Filename).websharper.stamp')</_WebSharperStamp>
    </PropertyGroup>
    <!-- unchanged files keep their timestamps, so an unchanged stamp does not trigger dependent compilations -->
    <Copy SourceFiles="$(_WebSharperStamp)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Retries="$(CopyRetryCount)" RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" Condition="Exists('$(_WebSharperStamp)')">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
    <Copy SourceFiles="$(_WebSharperSidecar)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="$(SkipCopyUnchangedFiles)" Retries="$(CopyRetryCount)" RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" Condition="Exists('$(_WebSharperSidecar)')">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
  </Target>
  <!-- files of references the last WebSharper compilation depended on: stamps of libraries, or their sidecars when all of their metadata was read -->
  <Target Name="WebSharperDependencyInputs" BeforeTargets="BeforeBuild" Condition=" '$(WebSharperRunCompiler)' == 'True' ">
    <PropertyGroup>
      <_WebSharperDepsFile>@(IntermediateAssembly->'%(RootDir)%(Directory)%(Filename).websharper.deps')</_WebSharperDepsFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_WebSharperDepsFile)" Condition="Exists('$(_WebSharperDepsFile)')">
      <Output TaskParameter="Lines" ItemName="_WebSharperDependency" />
    </ReadLinesFromFile>
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="@(_WebSharperDependency)" Condition="Exists('%(_WebSharperDependency.Identity)')" />
      <FileWrites Include="$(_WebSharperDepsFile)" />
    </ItemGroup>
  </Target>
  <Target Name="WebSharperPackSidecar">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutDir)$(TargetName).websharper" Condition="Exists('$(OutDir)$(TargetName).websharper')" />
    </ItemGroup>
  </Target>
</Project>
